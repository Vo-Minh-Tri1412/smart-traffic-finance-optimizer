[gd_resource type="Resource" script_class="BuildingPlacementProfile" format=3]

[ext_resource type="Script" path="res://scripts/assets/building_placement_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_name = "Residential"
description = "Dense urban housing: small footprints, medium height, moderate spacing."
min_building_footprint_m2 = 45.0
max_building_footprint_m2 = 140.0
target_coverage_ratio = 0.34
placement_pattern = "grid_jittered"
min_fill_ratio = 0.86
min_buildings = 1
max_buildings = 180
road_setback_m = 5.0
building_spacing_m = 3.5
boundary_setback_m = 2.0
grid_jitter_m = 1.2
min_floors = 2
max_floors = 8
nominal_asset_footprint_m2 = 90.0
max_asset_scale_multiplier = 8.0
rotation_strategy = "perpendicular_mix"
rotation_jitter_degrees = 3.0
perpendicular_rotation_probability = 0.18
