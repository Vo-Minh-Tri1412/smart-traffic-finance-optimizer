[gd_resource type="Resource" script_class="BuildingPlacementProfile" format=3]

[ext_resource type="Script" path="res://scripts/assets/building_placement_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_name = "Mixed Use"
description = "Mixed-use background with moderate footprints and varied height."
min_building_footprint_m2 = 80.0
max_building_footprint_m2 = 300.0
target_coverage_ratio = 0.26
placement_pattern = "organic_random"
min_fill_ratio = 0.8
min_buildings = 1
max_buildings = 140
road_setback_m = 5.0
building_spacing_m = 5.0
boundary_setback_m = 2.5
grid_jitter_m = 1.5
min_floors = 2
max_floors = 10
nominal_asset_footprint_m2 = 140.0
max_asset_scale_multiplier = 9.0
rotation_strategy = "perpendicular_mix"
rotation_jitter_degrees = 5.0
perpendicular_rotation_probability = 0.35
