[gd_resource type="Resource" script_class="BuildingPlacementProfile" format=3]

[ext_resource type="Script" path="res://scripts/assets/building_placement_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_name = "Industrial"
description = "Industrial yards: few wide buildings, low floors, large spacing."
min_building_footprint_m2 = 900.0
max_building_footprint_m2 = 9000.0
target_coverage_ratio = 0.22
placement_pattern = "yard_cluster"
min_fill_ratio = 0.76
min_buildings = 1
max_buildings = 90
road_setback_m = 12.0
building_spacing_m = 18.0
boundary_setback_m = 8.0
grid_jitter_m = 3.0
min_floors = 1
max_floors = 3
nominal_asset_footprint_m2 = 2200.0
max_asset_scale_multiplier = 18.0
rotation_strategy = "perpendicular_mix"
rotation_jitter_degrees = 2.5
perpendicular_rotation_probability = 0.45
