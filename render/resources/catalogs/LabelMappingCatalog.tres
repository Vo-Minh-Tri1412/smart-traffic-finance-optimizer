[sub_resource type="Resource" id="Label_taxi"]
script = ExtResource("2_entry")
vehicle_type = "TAXI_RIDE_HAILING"
class_id = 5
label_name = "taxi_ride_hailing"
vehicle_type_aliases = ["TAXI"]

[resource]
script = ExtResource("1_catalog")
entries = [SubResource("Label_motorbike"), SubResource("Label_car"), SubResource("Label_bus"), SubResource("Label_truck"), SubResource("Label_ambulance"), SubResource("Label_taxi")]
fallback_class_id = -1
fallback_class_name = "unknown"
