show_roadside_props = false
roadside_prop_scenes = []
roadside_prop_spacing_m = 105.0
roadside_prop_offset_m = 5.6
roadside_prop_scale = 0.035
roadside_prop_lane_stride = 9
max_roadside_props_per_lane = 0
description = "Default SUMO lane style for replay previews."

