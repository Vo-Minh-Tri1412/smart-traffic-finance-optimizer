.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

.env
.env.*
!.env.example

configs/*.local.json
configs/**/*.local.json

/artifacts/
/outputs/
/reports/
/models/
/sumo_runs/
!simulation_projects/
!simulation_projects/**/
!simulation_projects/**/outputs/
!simulation_projects/**/reports/
!simulation_projects/**/sumo_generated/
simulation_projects/**/outputs/*
simulation_projects/**/reports/*
simulation_projects/**/sumo_generated/*
!simulation_projects/**/outputs/.gitkeep
!simulation_projects/**/reports/.gitkeep
!simulation_projects/**/sumo_generated/.gitkeep

# Keep real/local datasets out of Git, but allow neutral templates.
data/**
!data/
!data/README.md
!data/raw/
!data/raw/.gitkeep
!data/interim/
!data/interim/.gitkeep
!data/processed/
!data/processed/.gitkeep
!data/external/
!data/external/.gitkeep
!data/catalog/
!data/catalog/*.template.csv
!data/catalog/*.template.md
!data/catalog/*.template.json

# Godot editor cache and generated render outputs stay out of Git.
render/.godot/
render/**/*.gd.uid
render/generated/
render/exports/
render/screenshots/
render/datasets/
render/videos/
render/captures/
render/outputs/*
!render/outputs/.gitkeep
